# Local Docker Compose defaults. Replace placeholders for your environment.
POSTGRES_DB=knowledge_agent
POSTGRES_USER=knowledge_agent
POSTGRES_PASSWORD=change_me_locally
DATABASE_URL=postgresql+psycopg://knowledge_agent:change_me_locally@localhost:5432/knowledge_agent
APP_ENV=development
LOG_LEVEL=INFO
# Production Netlify origin; localhost:5173 and 127.0.0.1:5173 are always allowed.
CORS_ORIGINS=https://enterprise-knowledge-agententerprise.netlify.app
MAX_UPLOAD_BYTES=20971520
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
# Point these at any OpenAI-compatible /v1 API, including a local inference server.
# Leave blank until a provider is configured. Never commit real keys.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.2
AGENT_MAX_ADDITIONAL_SEARCHES=2
AGENT_CONTEXT_CHUNKS=12
# Optional provider prices per million tokens; set only for your chosen provider/model.
# LLM_INPUT_COST_PER_MILLION=0
# LLM_OUTPUT_COST_PER_MILLION=0

